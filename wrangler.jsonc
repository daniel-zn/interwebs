{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interwebs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // /astro-angler redirects to /astro-angler/ so relative asset paths resolve.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "interwebs.danielzn.com", "custom_domain": true }
  ]
}
