{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interwebs",
  "compatibility_date": "2026-09-01",
  // Wrangler runs this before every deploy/dev, so dist/ is always fresh.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    // /reentry-surf redirects to /reentry-surf/ so relative asset paths resolve.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "interwebs.danielzn.com", "custom_domain": true }
  ]
}
